{
  "name": "elead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:example",
    "dev:example": "vite --config apps/example/vite.config.ts",
    "dev:console": "vite --config apps/console/vite.config.ts",
    "build": "tsc -b && vite build --config apps/example/vite.config.ts && vite build --config apps/console/vite.config.ts",
    "build:example": "tsc -b apps/example && vite build --config apps/example/vite.config.ts",
    "build:console": "tsc -b apps/console && vite build --config apps/console/vite.config.ts",
    "lint": "oxlint",
    "preview:example": "vite preview --config apps/example/vite.config.ts",
    "preview:console": "vite preview --config apps/console/vite.config.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
